# ZUNO Technologies — environment variables
# Copy to .env for local development, or set these in your host's secret manager.
# NEVER commit the real .env file.

# --- Security (required in production) ---
# 48+ random bytes, hex. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Initial administrator (created on first boot if it does not exist) ---
# Change the password after first login (Administrator Settings -> Change password).
ADMIN_EMAIL=ebulejames9@gmail.com
ADMIN_PASSWORD=change-me-on-first-login

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Optional: persistent storage (point at a mounted volume) ---
# When set, the SQLite database and uploaded media live here and survive restarts.
# ZUNO_DATA_DIR=/data
# DB_PATH=/data/zuno.db
# UPLOAD_DIR=/data/uploads

# --- Optional: contact-form email notifications ---
# If unset, contact messages are still saved to the database and shown in the
# admin dashboard (Customer Care -> Contact Messages); no email is sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Zuno Website <no-reply@example.com>"
# NOTIFY_EMAIL=zunocustomerscare@gmail.com
